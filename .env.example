# Copy this file to .env and fill in your own keys.
# .env is gitignored -- never commit the real one.

# Groq -- the LLM driving both the agent and the baseline
GROQ_API_KEY=

# Tavily -- web search tool
TAVILY_API_KEY=

# OpenWeather -- weather tool
OPENWEATHER_API_KEY=

# Optional. The model used when re-running the benchmark.
# The committed results were produced with llama-3.3-70b-versatile, which
# Groq has since decommissioned. Defaults to openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b
